    {
      "name": "04 - Logout y revocación",
      "item": [
        {
          "name": "Logout estudiante",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/logout/",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bibliotech_token_estudiante}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logout responde 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"Logout no devuelve contenido\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reutilizar token revocado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me/",
            "auth": {
              "type": "bearer",
              "bearer": [
