{
  "info": {
    "_postman_id": "a1fa89ec-0288-4cf8-b37c-420533f3b8f9",
    "name": "BiblioTech | Autenticación y roles (3.1)",
    "description": "Colección independiente, sin archivo Environment. Usa cuentas de seed_auth_demo.py en rama dev. IMPORTANTE: ejecutar primero los logins y dejar logout para el final. Los scripts de login guardan tokens en Postman Globals (bibliotech_token_bibliotecario, bibliotech_token_estudiante, bibliotech_token_docente), compartidos con la colección de préstamos. Los tokens se generan localmente en Postman y no se incluyen en el JSON exportado. Si aún no existen usuarios: docker compose exec backend python manage.py seed_auth_demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Estado",
      "item": [
        {
          "name": "Estado público",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/estado/",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"La respuesta indica éxito\", () => pm.expect(pm.response.json().status).to.eql(\"success\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Login",
      "item": [
        {
          "name": "Login estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_estudiante}}\",\n  \"password\": \"{{password_demo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login estudiante responde 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Devuelve token Bearer\", () => { pm.expect(json.token).to.be.a(\"string\"); pm.expect(json.tipo_token).to.eql(\"Bearer\"); });",
                  "pm.test(\"Rol estudiante y límite 5\", () => { pm.expect(json.usuario.rol.nombre).to.eql(\"estudiante\"); pm.expect(json.usuario.rol.limite_prestamos_activos).to.eql(5); });",
                  "pm.test(\"No expone contraseña\", () => { pm.expect(json.usuario).to.not.have.property(\"contrasena_hash\"); pm.expect(json.usuario).to.not.have.property(\"password\"); });",
                  "if (pm.response.code === 200 && json.token) pm.globals.set(\"bibliotech_token_estudiante\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login docente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_docente}}\",\n  \"password\": \"{{password_demo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login docente responde 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Rol docente y límite 5\", () => { pm.expect(json.usuario.rol.nombre).to.eql(\"docente\"); pm.expect(json.usuario.rol.limite_prestamos_activos).to.eql(5); });",
                  "if (pm.response.code === 200 && json.token) pm.globals.set(\"bibliotech_token_docente\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login bibliotecario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
