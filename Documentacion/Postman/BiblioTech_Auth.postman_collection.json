                  "const json = pm.response.json();",
                  "pm.test(\"Identifica al estudiante\", () => { pm.expect(json.email).to.eql(\"{{email_estudiante}}\"); pm.expect(json.rol.nombre).to.eql(\"estudiante\"); });",
                  "pm.test(\"No devuelve datos sensibles\", () => { pm.expect(json).to.not.have.property(\"contrasena_hash\"); pm.expect(json).to.not.have.property(\"password\"); });"
                ]
