          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login bibliotecario responde 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Rol bibliotecario y límite 0\", () => { pm.expect(json.usuario.rol.nombre).to.eql(\"bibliotecario\"); pm.expect(json.usuario.rol.limite_prestamos_activos).to.eql(0); });",
                  "if (pm.response.code === 200 && json.token) pm.globals.set(\"bibliotech_token_bibliotecario\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Password incorrecto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_estudiante}}\",\n  \"password\": \"NoEsLaClave123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Credenciales incorrectas responden 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"No devuelve token\", () => pm.expect(pm.response.json()).to.not.have.property(\"token\"));",
                  "pm.test(\"Mensaje correcto\", () => pm.expect(pm.response.json().detail).to.eql(\"Credenciales incorrectas.\"));"
                ]
              }
            }
          ]
        },
