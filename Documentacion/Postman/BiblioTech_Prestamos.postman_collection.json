        {
          "name": "Todos los préstamos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prestamos/?estado=todos&page=1&page_size=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "prestamos"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "todos"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Paginación y resumen administrativo\", function () {",
                  " const data = pm.response.json();",
                  " pm.expect(data).to.have.property('count');",
                  " pm.expect(data).to.have.property('results').that.is.an('array');",
                  " pm.expect(data).to.have.property('resumen');",
                  " pm.expect(data.resumen).to.have.all.keys('total','en_prestamo','vencidos','devueltos');",
                  "});"
                ]
              }
            }
          ]
        },
