{
  "info": {
    "_postman_id": "535d3231-3da1-4563-ae59-6b0be62c4906",
    "name": "BiblioTech | Préstamos (registro, listado admin y consulta personal)",
    "description": "Colección SOLO de préstamos, separada de Autenticación. Primero ejecutar Login bibliotecario y Login estudiante en la colección BiblioTech | Autenticación y roles. Ambas colecciones comparten tokens mediante Postman Globals: bibliotech_token_bibliotecario y bibliotech_token_estudiante. Sin archivo Environment. Variables usuario_id y ejemplar_id son ejemplos: reemplazar por IDs reales antes de elegibilidad o POST. Crear préstamo escribe datos REALES en la base de datos. El listado GET administrativo requiere haber implementado la ampliación en dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bibliotech_token_bibliotecario}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "busqueda",
      "value": "Esmeralda",
      "type": "string"
    },
    {
      "key": "usuario_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "ejemplar_id",
      "value": "1",
      "type": "string"
    }
  ],
